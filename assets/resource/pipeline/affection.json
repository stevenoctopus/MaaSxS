{
    // Affection check: go to Friends > Affection Tokens, claim anything
    // pending, and read "Affection Tokens Earned This Week: N/1000".
    //
    // Route: Daily Dungeon list -> Journal -> Home -> menu -> Friends -> heart.
    // Affection_Where is a hub: it recognises which screen we're on and takes
    // the next step, so the task works from anywhere along that route.

    // Start: same as Affection_Where, plus Common_GoHome for screens off the
    // route. Only the first step has that fallback: later steps can catch a
    // screen mid-animation, and a trip home there would undo progress.
    "Affection_Check": {
        "next": [
            "Affection_Claim",
            "Affection_FriendsPage",
            "Affection_MenuOpen",
            "Affection_Home",
            "Affection_Journal",
            "Affection_DungeonList",
            "[JumpBack]Common_GoHome"
        ]
    },

    "Affection_Where": {
        "next": [
            "Affection_Claim",
            "Affection_FriendsPage",
            "Affection_MenuOpen",
            "Affection_Home",
            "Affection_Journal",
            "Affection_DungeonList"
        ]
    },

    // Affection Tokens popup: always press Claim (harmless when nothing is
    // pending), then read the total.
    "Affection_Claim": {
        "focus": { "Node.Action.Starting": "Claiming affection tokens" },
        "recognition": "And",
        "all_of": [
            {
                "recognition": "OCR",
                "expected": "Earned\\s?This\\s?Week",
                "roi": [100, 310, 520, 60]
            },
            {
                "recognition": "OCR",
                "expected": "^Claim$",
                "roi": [240, 930, 240, 75]
            }
        ],
        "box_index": 1,
        "action": "Click",
        "post_delay": 1500, // let the total update
        "next": ["Affection_Read"]
    },

    // Read "Affection Tokens Earned This Week: N/1000", then go back.
    // The agent (agent/affection.py) parses N and the cap from this node.
    "Affection_Read": {
        "recognition": "OCR",
        "expected": "Earned\\s?This\\s?Week:\\s?\\d+\\s?/\\s?\\d+",
        "roi": [100, 310, 520, 60],
        "next": ["Affection_Return"]
    },

    // Friends page: open the Affection Tokens popup (heart button).
    "Affection_FriendsPage": {
        "recognition": "OCR",
        "expected": "^Friends:\\s?\\d+",
        "roi": [20, 100, 260, 50],
        "action": "Click",
        "target": [320, 1065, 80, 80],
        "next": ["Affection_Where"]
    },

    // Main menu is open: tap Friends.
    "Affection_MenuOpen": {
        "recognition": "OCR",
        "expected": "^Friends$",
        "roi": [45, 840, 120, 50],
        "action": "Click",
        "next": ["Affection_Where"]
    },

    // Home tab: open the menu (cube icon, right side).
    "Affection_Home": {
        "recognition": "And",
        "all_of": [
            {
                "recognition": "OCR",
                "expected": "^Home$",
                "roi": [250, 1235, 220, 45]
            },
            {
                "recognition": "TemplateMatch",
                "template": "Affection/menu_button.png",
                "roi": [560, 880, 160, 240]
            }
        ],
        "box_index": 1, // click the menu button
        "action": "Click",
        "next": ["Affection_Where"]
    },

    // Journal tab (activity menu): switch to the Home tab.
    "Affection_Journal": {
        "recognition": "OCR",
        "expected": "Free\\s?Attempts",
        "roi": [0, 180, 300, 60],
        "action": "Click",
        "target": [320, 1175, 90, 80], // house icon, bottom middle
        "next": ["Affection_Where"]
    },

    // ---------------------------------------------------------------
    // Return to the Daily Dungeon list from anywhere on the route.
    // Android back (keycode 4) closes the popup, Friends page and menu.
    // NEVER send back on Home: it opens "Quit the game?".

    "Affection_Return": {
        "next": [
            "[JumpBack]Common_QuitDialog",
            "Affection_Ret_DungeonList",
            "Affection_Ret_Journal",
            "Affection_Ret_Home",
            "Affection_Ret_Popup",
            "Affection_Ret_FriendsPage",
            "Affection_Ret_MenuOpen"
        ]
    },
    "Affection_Ret_Popup": {
        "recognition": "OCR",
        "expected": "Earned\\s?This\\s?Week",
        "roi": [100, 310, 520, 60],
        "action": "ClickKey",
        "key": 4,
        "next": ["Affection_Return"]
    },
    "Affection_Ret_FriendsPage": {
        "recognition": "OCR",
        "expected": "^Friends:\\s?\\d+",
        "roi": [20, 100, 260, 50],
        "action": "ClickKey",
        "key": 4,
        "next": ["Affection_Return"]
    },
    "Affection_Ret_MenuOpen": {
        "recognition": "OCR",
        "expected": "^Friends$",
        "roi": [45, 840, 120, 50],
        "action": "ClickKey",
        "key": 4,
        "next": ["Affection_Return"]
    },
    // Home: switch to the Journal tab (scroll icon, 2nd from the left).
    "Affection_Ret_Home": {
        "recognition": "OCR",
        "expected": "^Home$",
        "roi": [250, 1235, 220, 45],
        "action": "Click",
        "target": [175, 1180, 80, 70],
        "next": ["Affection_Return"]
    },
    // Journal: open the Daily Dungeon tile.
    "Affection_Ret_Journal": {
        "recognition": "OCR",
        "expected": "^Daily\\s?Dungeon$",
        "roi": [0, 140, 300, 60],
        "action": "Click",
        "next": ["Affection_Return"]
    },
    // Back on the list: done.
    "Affection_Ret_DungeonList": {
        "focus": { "Node.Action.Starting": "Back on the Daily Dungeon list" },
        "recognition": "OCR",
        "expected": "Daily\\s?Reward\\s?Attempts",
        "roi": [200, 20, 320, 60]
    },

    // Daily Dungeon list: back out to the Journal.
    "Affection_DungeonList": {
        "recognition": "OCR",
        "expected": "Daily\\s?Reward\\s?Attempts",
        "roi": [200, 20, 320, 60],
        "action": "Click",
        "target": [30, 1185, 90, 70],
        "next": ["Affection_Where"]
    }
}
