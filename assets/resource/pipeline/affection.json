{
    // Affection check (used by Daily Dungeon's Affection mode): go to
    // Home > menu > Friends > Affection Tokens, claim anything pending, read
    // "Affection Tokens Earned This Week: N/1000", then go to the Daily
    // Dungeon list. The agent (agent/affection.py) reads N from Affection_Read.

    // Start from any screen: off the route, Common_GoHome takes us Home.
    // Only the first step has that fallback: later steps can catch a screen
    // mid-animation, and a trip home there would undo progress.
    "Affection_Check": {
        "next": [
            "Affection_Claim",
            "Affection_FriendsPage",
            "Affection_MenuOpen",
            "Affection_Home",
            "[JumpBack]Common_GoHome"
        ]
    },
    "Affection_Where": {
        "next": ["Affection_Claim", "Affection_FriendsPage", "Affection_MenuOpen", "Affection_Home"]
    },

    // Home tab: open the menu (cube icon, right side).
    "Affection_Home": {
        "recognition": "And",
        "all_of": ["Screen_HomeLabel", "Screen_HomeMenuButton"],
        "box_index": 1, // click the menu button
        "action": "Click",
        "next": ["Affection_Where"]
    },
    // Menu open: tap Friends.
    "Affection_MenuOpen": {
        "recognition": "And",
        "all_of": ["Screen_MainMenu"],
        "action": "Click",
        "next": ["Affection_Where"]
    },
    // Friends page: open the Affection Tokens popup (heart button).
    "Affection_FriendsPage": {
        "recognition": "And",
        "all_of": ["Screen_FriendsPage"],
        "action": "Click",
        "target": [320, 1065, 80, 80],
        "next": ["Affection_Where"]
    },
    // Affection Tokens popup: always press Claim (harmless when nothing is
    // pending), then read the total.
    "Affection_Claim": {
        "focus": { "Node.Action.Starting": "Claiming affection tokens" },
        "recognition": "And",
        "all_of": [
            "Screen_AffectionPopup",
            { "recognition": "OCR", "expected": "^Claim$", "roi": [240, 930, 240, 75] }
        ],
        "box_index": 1,
        "action": "Click",
        "post_delay": 1500, // let the total update
        "next": ["Affection_Read"]
    },
    "Affection_Read": {
        "recognition": "OCR",
        "expected": "Earned\\s?This\\s?Week:\\s?\\d+\\s?/\\s?\\d+",
        "roi": [100, 310, 520, 60],
        "next": ["DailyDungeon_ToList"]
    }
}
