{
    // Material Realms (Journal > Material Realms): Ironvein Pit, Gilded
    // Depths, Dread Hollow, Dustfall Dune. Each realm uses its own tool
    // (hammer, pickaxe, glove, shovel). The agent (agent/material_realms.py)
    // visits each realm once: buys tool sets on its page, then uses tools.
    // The "Sets to buy" option sets MaterialRealms_Buy's param, "Tools to
    // use" sets MaterialRealms_Use's.
    // Top-level steps have on_error -> Common_Retry: if anything fails, go
    // Home and start the task over, once.
    "MaterialRealms": {
        "next": ["MaterialRealms_OnList", "[JumpBack]MaterialRealms_ToList"],
        "on_error": ["Common_Retry"]
    },
    "MaterialRealms_OnList": {
        "recognition": "And",
        "all_of": ["Screen_MaterialList"],
        "next": ["MaterialRealms_Use"],
        "on_error": ["Common_Retry"],
        "focus": { "Node.Action.Starting": "On the Material Realms list" }
    },
    // Settings only, never run: sets of 5 tools to buy per realm per day
    // (0 = none). Read by the MaterialRealms action.
    "MaterialRealms_Buy": {
        "action": "Custom",
        "custom_action": "MaterialRealms",
        "custom_action_param": { "ironvein": 0, "gilded": 0, "dread": 0, "dustfall": 0 }
    },
    // Tools to use per realm (a number, or "ALL"); runs the whole task.
    "MaterialRealms_Use": {
        "action": "Custom",
        "custom_action": "MaterialRealms",
        "custom_action_param": { "ironvein": "ALL", "gilded": "ALL", "dread": "ALL", "dustfall": "ALL" },
        "on_error": ["Common_Retry"]
    },

    // ---------------------------------------------------------------
    // Get to the Material Realms list from any screen: tab bar > Journal >
    // Material Realms. Use as "[JumpBack]MaterialRealms_ToList", or as a
    // next to end there.
    "MaterialRealms_ToList": {
        "next": [
            "Screen_MaterialList",
            "MaterialRealms_ToList_Realm",
            "MaterialRealms_ToList_Journal",
            "[JumpBack]Common_ToJournal"
        ]
    },
    // A realm's page (title, no Quick Purchase): back arrow to the list.
    "MaterialRealms_ToList_Realm": {
        "recognition": "And",
        "all_of": ["Screen_MaterialTitle"],
        "action": "Click",
        "target": [30, 1185, 90, 70],
        "post_delay": 1500,
        "next": ["Screen_MaterialList", "MaterialRealms_ToList_Realm"]
    },
    "MaterialRealms_ToList_Journal": {
        // Material Realms tile on the Journal
        "recognition": "OCR",
        "roi": [0, 1080, 300, 70],
        "expected": "^Material\\s?Realms$",
        "action": "Click",
        "post_delay": 1000,
        "next": ["Screen_MaterialList"]
    },

    // ---------------------------------------------------------------
    // Buying on a realm's page (not Quick Purchase: once a realm has bought
    // sets today, its Quick Purchase row can't go below 1). The "+" by the
    // tool count opens "Purchase <tool>", a Purchase popup (the shared
    // Common_Purchase_* nodes, agent/purchase.py): Qty in sets of 5,
    // "Daily Purchase Limit: U/20". It opens even when the limit is used up.
    "MaterialRealms_Buy_Open": {
        "action": "Click",
        "target": [672, 36, 34, 34],
        "post_delay": 1500,
        "next": ["Common_Purchase_Limit"]
    },
    // Tools held, shown on the list as a small blue badge at the top right
    // of each tile (no badge = 0 tools). The agent sets the roi per realm.
    "MaterialRealms_ListCount": {
        "recognition": "OCR",
        "roi": [318, 168, 40, 34],
        "expected": "^\\d+"
    },

    // ---------------------------------------------------------------
    // A realm's page. The agent sets the tile's expected/roi per realm.
    "MaterialRealms_OpenRealm": {
        "recognition": "OCR",
        "roi": [20, 950, 280, 60],
        "expected": "^Dread\\s?Hollow$",
        "action": "Click",
        "post_delay": 2000,
        "next": ["MaterialRealms_OnRealm"]
    },
    "MaterialRealms_OnRealm": {
        // the tab at the bottom names the realm
        "recognition": "And",
        "all_of": [
            "Screen_MaterialTitle",
            { "recognition": "OCR", "roi": [150, 1185, 210, 50], "expected": "^Dread\\s?Hollow$" }
        ]
    },
    "MaterialRealms_ToolCount": {
        // tools held, top right (the far-right counter)
        "recognition": "OCR",
        "roi": [610, 28, 70, 45],
        "expected": "^\\d+"
    },
    // The big tool button: one tap uses 1 tool, or with Quick Mine / Quick
    // Conquer on, enough tools to finish the current mine or monster.
    "MaterialRealms_UseTool": {
        "action": "Click",
        "target": [320, 885, 80, 80],
        "post_delay": 1500
    },
    // Quick Mine / Quick Conquer is on: its knob is yellow, on the right.
    "MaterialRealms_QuickOn": {
        "recognition": "ColorMatch",
        "roi": [420, 1038, 40, 36],
        "method": 4, // RGB
        "lower": [170, 175, 70],
        "upper": [230, 230, 140],
        "count": 60
    },
    "MaterialRealms_QuickToggle": {
        "action": "Click",
        "target": [380, 1040, 70, 30],
        "post_delay": 1000
    },
    "MaterialRealms_RealmBack": {
        // back arrow to the list
        "action": "Click",
        "target": [30, 1185, 90, 70],
        "post_delay": 1500,
        "next": ["Screen_MaterialList"]
    }
}
