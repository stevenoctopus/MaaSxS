{
    // Shared routines. Call them from a task's `next` with the [JumpBack]
    // prefix, e.g. "[JumpBack]Common_ToTabBar": the routine runs to its end,
    // then the calling node checks its `next` list again.
    // Screen checks (Screen_*) are in screens.json.

    // Shows a message in the GUI log. The agent runs this with its text as
    // the focus (agent/gui.py), so agent messages appear in the GUI too.
    "Common_Log": {
        "focus": { "Node.Action.Starting": "" }
    },

    // Retry for any task: put "on_error": ["Common_Retry"] on a task's
    // top-level steps. If one fails, the agent (agent/common.py) goes Home
    // and runs the task's entry again with the same options, once.
    "Common_Retry": {
        "action": "Custom",
        "custom_action": "RetryFromHome"
    },

    // ---------------------------------------------------------------
    // Get to any screen with the bottom tab bar (Home, Journal, Guild, ...)
    // from anywhere, including after a crash or disconnect.
    // Known screens get a direct step, each of which starts this over.
    // Unknown screen: Android back, twice; still unknown, the game is
    // probably not in front (crashed), so start it (no-op if it's already
    // in front) and look again.
    // The four next lists below are the same list; keep them in step.
    "Common_ToTabBar": {
        "next": [
            "[JumpBack]Common_QuitDialog",
            "Common_TabBar_Done",
            "Common_TabBar_ReturnPrompt",
            "Common_TabBar_Notice",
            "Common_TabBar_TapToPlay",
            "Common_TabBar_Loading",
            "Common_TabBar_DungeonList",
            "Common_TabBar_DungeonDetail",
            "Common_TabBar_DungeonResults",
            "Common_TabBar_TapToContinue",
            "Common_TabBar_BackOut",
            "Common_TabBar_Battle"
        ],
        "timeout": 3000,
        "on_error": ["Common_TabBar_Back1"]
    },
    "Common_TabBar_Back1": {
        "focus": { "Node.Action.Starting": "Unknown screen: pressing back" },
        "action": "ClickKey",
        "key": 4,
        "post_delay": 1500,
        "next": [
            "[JumpBack]Common_QuitDialog",
            "Common_TabBar_Done",
            "Common_TabBar_ReturnPrompt",
            "Common_TabBar_Notice",
            "Common_TabBar_TapToPlay",
            "Common_TabBar_Loading",
            "Common_TabBar_DungeonList",
            "Common_TabBar_DungeonDetail",
            "Common_TabBar_DungeonResults",
            "Common_TabBar_TapToContinue",
            "Common_TabBar_BackOut",
            "Common_TabBar_Battle"
        ],
        "timeout": 3000,
        "on_error": ["Common_TabBar_Back2"]
    },
    "Common_TabBar_Back2": {
        "action": "ClickKey",
        "key": 4,
        "post_delay": 1500,
        "next": [
            "[JumpBack]Common_QuitDialog",
            "Common_TabBar_Done",
            "Common_TabBar_ReturnPrompt",
            "Common_TabBar_Notice",
            "Common_TabBar_TapToPlay",
            "Common_TabBar_Loading",
            "Common_TabBar_DungeonList",
            "Common_TabBar_DungeonDetail",
            "Common_TabBar_DungeonResults",
            "Common_TabBar_TapToContinue",
            "Common_TabBar_BackOut",
            "Common_TabBar_Battle"
        ],
        "timeout": 3000,
        "on_error": ["Common_TabBar_StartGame"]
    },
    // max_hit stops an endless loop if the game never shows a known screen.
    "Common_TabBar_StartGame": {
        "focus": { "Node.Action.Starting": "Game not in front: starting it" },
        "action": "StartApp",
        "package": "com.zjcs.android.us",
        "post_delay": 3000,
        "max_hit": 10,
        "next": [
            "[JumpBack]Common_QuitDialog",
            "Common_TabBar_Done",
            "Common_TabBar_ReturnPrompt",
            "Common_TabBar_Notice",
            "Common_TabBar_TapToPlay",
            "Common_TabBar_Loading",
            "Common_TabBar_DungeonList",
            "Common_TabBar_DungeonDetail",
            "Common_TabBar_DungeonResults",
            "Common_TabBar_TapToContinue",
            "Common_TabBar_BackOut",
            "Common_TabBar_Battle"
        ],
        "timeout": 20000, // the game's splash screen can take a while
        "on_error": ["Common_TabBar_Back1"]
    },

    "Common_TabBar_Done": {
        "recognition": "And",
        "all_of": ["Screen_TabBar"]
    },

    // --- Game start-up (after a crash, disconnect or fresh launch) ---
    "Common_TabBar_Notice": { // close the Notice popup (back arrow)
        "focus": { "Node.Action.Starting": "Game start-up: closing the Notice" },
        "recognition": "And",
        "all_of": ["Screen_Notice"],
        "action": "Click",
        "target": [30, 1185, 90, 70],
        "post_delay": 2000,
        "next": ["Common_ToTabBar"]
    },
    "Common_TabBar_TapToPlay": {
        "focus": { "Node.Action.Starting": "Game start-up: Tap to Play" },
        "recognition": "And",
        "all_of": ["Screen_TapToPlay"],
        "action": "Click",
        "post_delay": 5000,
        "next": ["Common_ToTabBar"]
    },
    "Common_TabBar_Loading": { // wait
        "recognition": "And",
        "all_of": ["Screen_Loading"],
        "post_delay": 3000,
        "next": ["Common_ToTabBar"]
    },

    // "Confirm / Return to Home?" (e.g. back on the world map): press OK.
    "Common_TabBar_ReturnPrompt": {
        "recognition": "And",
        "all_of": [
            { "recognition": "OCR", "expected": "Return\\s?to\\s?Home", "roi": [100, 540, 520, 90] },
            { "recognition": "OCR", "expected": "^OK$", "roi": [370, 700, 250, 75] }
        ],
        "box_index": 1,
        "action": "Click",
        "post_delay": 2000, // the trip home loads for a moment
        "next": ["Common_ToTabBar"]
    },
    "Common_TabBar_DungeonList": { // back arrow, bottom left
        "recognition": "And",
        "all_of": ["Screen_DungeonList"],
        "action": "Click",
        "target": [30, 1185, 90, 70],
        "next": ["Common_ToTabBar"]
    },
    "Common_TabBar_DungeonDetail": { // back arrow, to the Dungeon list
        "recognition": "And",
        "all_of": ["Screen_DungeonDetail"],
        "action": "Click",
        "target": [30, 1185, 90, 70],
        "post_delay": 1500,
        "next": ["Common_ToTabBar"]
    },
    "Common_TabBar_DungeonResults": { // back arrow
        "recognition": "And",
        "all_of": ["Screen_DungeonResults"],
        "action": "Click",
        "target": [30, 1185, 90, 70],
        "post_delay": 1500,
        "next": ["Common_ToTabBar"]
    },
    "Common_TabBar_TapToContinue": { // Crucible results: tap through
        "recognition": "And",
        "all_of": ["Screen_TapToContinue"],
        "action": "Click",
        "post_delay": 1500,
        "next": ["Common_ToTabBar"]
    },
    // Sub-pages where Android back is safe: menu, Friends, Affection popup,
    // Crucible pages, Daily Events, Guild Events, Conquest, quests, and solo
    // battle setup (which already shows "Round 0/50", so it must come before
    // Common_TabBar_Battle).
    "Common_TabBar_BackOut": {
        "recognition": "Or",
        "any_of": [
            "Screen_AffectionPopup",
            "Screen_FriendsPage",
            "Screen_MainMenu",
            "Screen_CrucibleTitle",
            "Screen_SplitMirageTitle",
            "Screen_ArenaTitle",
            "Screen_CompetitionPage",
            "Screen_MaterialTitle",
            "Screen_VendorBooth",
            "Screen_DailyEvents",
            "Screen_GuildEvents",
            "Screen_ConquestPage",
            "Screen_QuestList",
            "Screen_StartBattle"
        ],
        "action": "ClickKey",
        "key": 4,
        "post_delay": 1000,
        "next": ["Common_ToTabBar"]
    },
    // A battle can't be left: wait for it to finish.
    "Common_TabBar_Battle": {
        "focus": { "Node.Action.Starting": "A battle is running: waiting for it to end" },
        "recognition": "And",
        "all_of": ["Screen_Battle"],
        "post_delay": 5000,
        "next": ["Common_ToTabBar"]
    },

    // The game's quit prompt (back on a main tab): always cancel.
    // Use as "[JumpBack]Common_QuitDialog".
    "Common_QuitDialog": {
        "recognition": "And",
        "all_of": [
            { "recognition": "OCR", "expected": "Quit the game", "roi": [100, 400, 520, 400] },
            { "recognition": "OCR", "expected": "^Cancel$", "roi": [100, 650, 260, 130] }
        ],
        "box_index": 1,
        "action": "Click"
    },

    // ---------------------------------------------------------------
    // Go to the Home tab: get to the tab bar, then tap the house icon.
    "Common_GoHome": {
        "next": ["[JumpBack]Common_QuitDialog", "Common_AtHome", "Common_Home_TapHouse", "[JumpBack]Common_ToTabBar"]
    },
    "Common_AtHome": {
        "focus": { "Node.Action.Starting": "On Home" },
        "recognition": "And",
        "all_of": ["Screen_Home"]
    },
    "Common_Home_TapHouse": { // house icon, bottom middle
        "recognition": "And",
        "all_of": ["Screen_TabBar"],
        "action": "Click",
        "target": [320, 1175, 90, 80],
        "next": ["Common_AtHome"]
    },

    // ---------------------------------------------------------------
    // Go to the Journal tab (Daily Dungeon, Daily Events, Competition,
    // Material Realms, ...): get to the tab bar, then tap the Journal tab
    // (scroll icon, 2nd from the left). Use as "[JumpBack]Common_ToJournal";
    // the task then taps its own tile.
    "Common_ToJournal": {
        "next": ["Common_ToJournal_Done", "Common_ToJournal_Tab", "[JumpBack]Common_ToTabBar"]
    },
    "Common_ToJournal_Done": {
        "recognition": "And",
        "all_of": ["Screen_Journal"]
    },
    "Common_ToJournal_Tab": {
        "recognition": "And",
        "all_of": ["Screen_TabBar"],
        "action": "Click",
        "target": [175, 1180, 80, 70],
        "next": ["Common_ToJournal_Done"]
    },

    // ---------------------------------------------------------------
    // Open the menu (cube button on Home: Friends, Quest, ...).
    // Use as "[JumpBack]Common_OpenMenu".
    "Common_OpenMenu": {
        "next": ["Common_OpenMenu_Done", "Common_OpenMenu_Home", "[JumpBack]Common_GoHome"]
    },
    "Common_OpenMenu_Done": {
        "recognition": "And",
        "all_of": ["Screen_MainMenu"]
    },
    "Common_OpenMenu_Home": {
        "recognition": "And",
        "all_of": ["Screen_HomeLabel", "Screen_HomeMenuButton"],
        "box_index": 1, // click the menu button
        "action": "Click",
        "next": ["Common_OpenMenu_Done"]
    },

    // ---------------------------------------------------------------
    // Matchmaking, shared by Daily Dungeon, Crucible and Split Mirage: from a screen with
    // the Match button until the battle starts. Use as "[JumpBack]Common_Queue".
    // Match, Accept (the game re-queues by itself if someone declines),
    // Match again if we get dropped, Ready.
    "Common_Queue": {
        "next": ["Common_Queue_Match"]
    },
    "Common_Queue_Match": {
        "focus": { "Node.Action.Starting": "Queueing for a match" },
        "recognition": "And",
        "all_of": ["Screen_MatchButton"],
        "action": "Click",
        "post_delay": 1500, // let the button switch to "Cancel"
        "timeout": 600000, // the queue: how long to wait for the accept prompt
        "next": ["Common_Queue_Accept", "Common_Queue_MaybeDropped"]
    },
    "Common_Queue_Accept": {
        "focus": { "Node.Action.Starting": "Match found: accepting" },
        "recognition": "And",
        "all_of": ["Screen_AcceptButton"],
        "action": "Click",
        "timeout": 600000,
        // The game auto-readies after a few seconds, so the battle may start
        // before we see the Ready button.
        "next": ["Common_Queue_Ready", "Common_Queue_InBattle", "Common_Queue_Accept", "Common_Queue_MaybeDropped"]
    },
    // Match showing again: dropped from the queue, or just the brief flash
    // while the battle loads. Wait, then look again before pressing Match.
    "Common_Queue_MaybeDropped": {
        "focus": { "Node.Action.Starting": "Back on Match: waiting, then re-queueing if dropped" },
        "recognition": "And",
        "all_of": ["Screen_MatchButton"],
        "post_delay": 10000,
        "timeout": 600000,
        "next": ["Common_Queue_Ready", "Common_Queue_InBattle", "Common_Queue_Accept", "Common_Queue_Match"]
    },
    "Common_Queue_Ready": {
        "focus": { "Node.Action.Starting": "Ready" },
        "recognition": "And",
        "all_of": ["Screen_ReadyButton"],
        "action": "Click",
        "timeout": 90000, // "Battle starts in 60s" countdown
        "next": ["Common_Queue_InBattle"]
    },
    "Common_Queue_InBattle": { // done: the battle has started
        "focus": { "Node.Action.Starting": "Battle in progress" },
        "recognition": "And",
        "all_of": ["Screen_Battle"]
    }
}
