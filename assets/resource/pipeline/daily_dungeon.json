{
    // Daily Dungeon task. Top-level steps have on_error -> Common_Retry: if
    // anything fails, go Home and start the task over, once.
    // (Affection mode overrides DailyDungeon's next with
    // DailyDungeon_AffectionFarm; see interface.json.)
    "DailyDungeon": {
        "next": ["DailyDungeon_OnList", "[JumpBack]DailyDungeon_ToList"],
        "on_error": ["Common_Retry"]
    },
    "DailyDungeon_OnList": {
        "focus": { "Node.Action.Starting": "On the Daily Dungeon list" },
        "recognition": "And",
        "all_of": ["Screen_DungeonList"],
        "next": ["DailyDungeon_SingleRun"],
        "on_error": ["Common_Retry"]
    },
    // One DailyDungeon_Run as a single step, so a failure anywhere in the
    // run reaches on_error.
    "DailyDungeon_SingleRun": {
        "action": "Custom",
        "custom_action": "RunTask",
        "custom_action_param": { "entry": "DailyDungeon_Run" },
        "on_error": ["Common_Retry"]
    },
    // Affection mode: check the weekly total, run until the cap, recheck and
    // top up. Logic lives in agent/affection.py.
    "DailyDungeon_AffectionFarm": {
        "action": "Custom",
        "custom_action": "AffectionFarm",
        "custom_action_param": { "per_run": 7 },
        "on_error": ["Common_Retry"]
    },

    // ---------------------------------------------------------------
    // Get to the Daily Dungeon list from any screen: tab bar > Journal > tile.
    // Use as "[JumpBack]DailyDungeon_ToList", or as a next to end there.
    "DailyDungeon_ToList": {
        "next": [
            "DailyDungeon_ToList_Done",
            "DailyDungeon_ToList_Journal",
            "DailyDungeon_ToList_TabBar",
            "[JumpBack]Common_ToTabBar"
        ]
    },
    "DailyDungeon_ToList_Done": {
        "recognition": "And",
        "all_of": ["Screen_DungeonList"]
    },
    "DailyDungeon_ToList_Journal": { // open the Daily Dungeon tile
        "recognition": "OCR",
        "expected": "^Daily\\s?Dungeon$",
        "roi": [0, 140, 300, 60],
        "action": "Click",
        "next": ["DailyDungeon_ToList_Done"]
    },
    "DailyDungeon_ToList_TabBar": { // Journal tab (scroll icon, 2nd from the left)
        "recognition": "And",
        "all_of": ["Screen_TabBar"],
        "action": "Click",
        "target": [175, 1180, 80, 70],
        "next": ["DailyDungeon_ToList_Journal"]
    },

    // ---------------------------------------------------------------
    // One complete run, starting and ending on the Daily Dungeon list.
    // The agent calls this repeatedly in Affection mode.
    "DailyDungeon_Run": {
        "next": ["DailyDungeon_SelectCard"]
    },
    // Tap the chosen dungeon's title. `expected` is set by the "Dungeon"
    // option. The ROI skips the page header and the bottom tab bar.
    "DailyDungeon_SelectCard": {
        "focus": { "Node.Action.Starting": "Opening the dungeon" },
        "recognition": "OCR",
        "expected": "Riftwatch\\s?Fortress", // OCR often drops the space in the title font
        "roi": [0, 110, 720, 1040],
        "action": "Click",
        "next": ["DailyDungeon_SelectDifficulty"]
    },
    // Tap the chosen difficulty tab (harmless if already selected).
    // `expected` is set by the "Difficulty" option.
    "DailyDungeon_SelectDifficulty": {
        "recognition": "OCR",
        "expected": "^Hard$",
        "roi": [150, 1180, 570, 80],
        "action": "Click",
        "next": ["DailyDungeon_DifficultySelected"]
    },
    // Confirm: the detail title reads "<Dungeon> - <Difficulty>".
    "DailyDungeon_DifficultySelected": {
        "recognition": "OCR",
        "expected": "Hard$",
        "roi": [100, 180, 520, 65],
        "next": ["DailyDungeon_InRun", "[JumpBack]Common_Queue"]
    },
    // The run is ~5 floors with room maps between them; the map votes
    // itself, so we just wait for the results screen.
    "DailyDungeon_InRun": {
        "recognition": "And",
        "all_of": ["Screen_Battle"],
        "timeout": 300000,
        "next": ["DailyDungeon_Results"]
    },
    // Results ("Drops"): tap back. The tap is sometimes swallowed while the
    // chests animate, so if the results are still showing, tap again.
    "DailyDungeon_Results": {
        "focus": { "Node.Action.Starting": "Battle ended: leaving the results" },
        "recognition": "And",
        "all_of": ["Screen_DungeonResults"],
        "pre_delay": 1500, // let the results animation finish
        "action": "Click",
        "target": [30, 1185, 90, 70], // back arrow, bottom left
        "post_delay": 1500,
        "timeout": 30000,
        "next": ["DailyDungeon_BackOnList", "DailyDungeon_Results"]
    },
    "DailyDungeon_BackOnList": {
        "focus": { "Node.Action.Starting": "Run complete" },
        "recognition": "And",
        "all_of": ["Screen_DungeonList"]
    }
}
