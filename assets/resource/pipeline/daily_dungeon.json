{
    // Daily Dungeon task. Top-level steps have on_error -> Common_Retry: if
    // anything fails, go Home and start the task over, once.
    // This is Daily mode; Affection mode overrides DailyDungeon's next with
    // DailyDungeon_AffectionFarm (see interface.json).
    "DailyDungeon": {
        "next": ["DailyDungeon_OnList", "[JumpBack]DailyDungeon_ToList"],
        "on_error": ["Common_Retry"]
    },
    "DailyDungeon_OnList": {
        "focus": { "Node.Action.Starting": "On the Daily Dungeon list" },
        "recognition": "And",
        "all_of": ["Screen_DungeonList"],
        "next": ["DailyDungeon_DailyFarm"],
        "on_error": ["Common_Retry"]
    },
    // Affection mode: check the weekly total, run until the cap, recheck and
    // top up, never claiming rewards. Logic lives in agent/affection.py.
    "DailyDungeon_AffectionFarm": {
        "action": "Custom",
        "custom_action": "AffectionFarm",
        "custom_action_param": { "per_run": 7 },
        "on_error": ["Common_Retry"]
    },
    // Daily mode: buy extra reward attempts, then run (and claim) until no
    // reward attempts are left. Logic lives in agent/daily_dungeon.py; the
    // "Buy extra attempts" option sets the param.
    "DailyDungeon_DailyFarm": {
        "action": "Custom",
        "custom_action": "DungeonDaily",
        "custom_action_param": { "buy": 2 },
        "on_error": ["Common_Retry"]
    },

    // ---------------------------------------------------------------
    // Get to the Daily Dungeon list from any screen: tab bar > Journal > tile.
    // Use as "[JumpBack]DailyDungeon_ToList", or as a next to end there.
    "DailyDungeon_ToList": {
        "next": [
            "DailyDungeon_ToList_Done",
            "DailyDungeon_ToList_Journal",
            "[JumpBack]Common_ToJournal"
        ]
    },
    "DailyDungeon_ToList_Done": {
        "recognition": "And",
        "all_of": ["Screen_DungeonList"]
    },
    "DailyDungeon_ToList_Journal": { // open the Daily Dungeon tile
        "recognition": "OCR",
        "expected": "^Daily\\s?Dungeon$",
        "roi": [0, 140, 300, 60],
        "action": "Click",
        "next": ["DailyDungeon_ToList_Done"]
    },

    // ---------------------------------------------------------------
    // One complete run, starting and ending on the Daily Dungeon list.
    // The agents (affection.py, daily_dungeon.py) call this once per run.
    "DailyDungeon_Run": {
        "next": ["DailyDungeon_SelectCard"]
    },
    // Tap the chosen dungeon's title. `expected` is set by the "Dungeon"
    // option. The ROI skips the page header and the bottom tab bar.
    "DailyDungeon_SelectCard": {
        "focus": { "Node.Action.Starting": "Opening the dungeon" },
        "recognition": "OCR",
        "expected": "Riftwatch\\s?Fortress", // OCR often drops the space in the title font
        "roi": [0, 110, 720, 1040],
        "action": "Click",
        "next": ["DailyDungeon_SelectDifficulty"]
    },
    // Tap the chosen difficulty tab (harmless if already selected).
    // `expected` is set by the "Difficulty" option.
    "DailyDungeon_SelectDifficulty": {
        "recognition": "OCR",
        "expected": "^Hard$",
        "roi": [150, 1180, 570, 80],
        "action": "Click",
        "next": ["DailyDungeon_DifficultySelected"]
    },
    // Confirm: the detail title reads "<Dungeon> - <Difficulty>".
    "DailyDungeon_DifficultySelected": {
        "recognition": "OCR",
        "expected": "Hard$",
        "roi": [100, 180, 520, 65],
        "next": ["DailyDungeon_InRun", "[JumpBack]Common_Queue"]
    },
    // The run is ~5 floors with room maps between them; the map votes
    // itself, so we just wait for the results screen.
    "DailyDungeon_InRun": {
        "recognition": "And",
        "all_of": ["Screen_Battle"],
        "timeout": 300000,
        "next": ["DailyDungeon_Results"]
    },
    // Results ("Drops"). By default (Affection mode): leave without claiming.
    // Daily mode runs with DailyDungeon_ClaimOverride (agent/daily_dungeon.py),
    // which claims instead.
    "DailyDungeon_Results": {
        "focus": { "Node.Action.Starting": "Battle ended" },
        "recognition": "And",
        "all_of": ["Screen_DungeonResults"],
        "pre_delay": 1500,
        "timeout": 30000,
        "next": ["DailyDungeon_Leave"]
    },
    // Tap back. With reward attempts left this asks "rewards not claimed.
    // Exit the dungeon?", answered by DailyDungeon_UnclaimedExit. The tap is
    // sometimes swallowed while the chests animate, so if the results are
    // still showing, tap again.
    "DailyDungeon_Leave": {
        "recognition": "And",
        "all_of": ["Screen_DungeonResults"],
        "action": "Click",
        "target": [30, 1185, 90, 70], // back arrow, bottom left
        "post_delay": 1500,
        "timeout": 30000,
        "next": ["DailyDungeon_BackOnList", "DailyDungeon_UnclaimedExit", "DailyDungeon_Leave"]
    },
    "DailyDungeon_UnclaimedExit": { // exit without claiming: OK
        "focus": { "Node.Action.Starting": "Leaving without claiming the rewards" },
        "recognition": "And",
        "all_of": [
            { "recognition": "OCR", "expected": "not\\s?claimed", "roi": [100, 500, 520, 120] },
            { "recognition": "OCR", "expected": "^OK$", "roi": [370, 700, 250, 75] }
        ],
        "box_index": 1,
        "action": "Click",
        "post_delay": 1500,
        "timeout": 30000,
        "next": ["DailyDungeon_BackOnList", "DailyDungeon_UnclaimedExit", "DailyDungeon_Leave"]
    },

    // Daily mode's results: the agent sets DailyDungeon_Results' next to
    // [Claim, LeaveResults, LowGrade, UnclaimedPrompt]. Claim the rewards if
    // the grade is good enough and a reward attempt is left, then tap back.
    // Leaving is only allowed once the button reads "Claimed", no attempts
    // are left, or the grade is too low: the Claim button appears a moment
    // after "Drops", and leaving early would forfeit the rewards.
    "DailyDungeon_Claim": {
        "focus": { "Node.Action.Starting": "Claiming the rewards (uses 1 reward attempt)" },
        "recognition": "And",
        "all_of": [
            { "recognition": "OCR", "expected": "^Claim\\s?Rewards$", "roi": [360, 1180, 320, 75] },
            { "recognition": "OCR", "expected": "Attempts:\\s?[1-9]", "roi": [370, 1135, 300, 45] },
            "DailyDungeon_GoodGrade"
        ], // clicks the first: Claim Rewards
        "action": "Click",
        "post_delay": 1500,
        "next": ["DailyDungeon_ClaimConfirm"]
    },
    // "Spend 1 reward attempt(s) to claim these dungeon rewards 1 time(s)?"
    "DailyDungeon_ClaimConfirm": {
        "recognition": "And",
        "all_of": [
            { "recognition": "OCR", "expected": "reward\\s?attempt", "roi": [100, 500, 520, 120] },
            { "recognition": "OCR", "expected": "^OK$", "roi": [370, 700, 250, 75] }
        ],
        "box_index": 1,
        "action": "Click",
        "post_delay": 2000,
        "timeout": 30000,
        "next": ["DailyDungeon_LeaveResults"]
    },
    // Tap back: only when claimed, or when there's no attempt to claim with.
    // The tap is sometimes swallowed while the chests animate, so if the
    // results are still showing, tap again.
    "DailyDungeon_LeaveResults": {
        "recognition": "And",
        "all_of": [
            "Screen_DungeonResults",
            {
                "recognition": "Or",
                "any_of": [
                    { "recognition": "OCR", "expected": "^Claimed$", "roi": [360, 1180, 320, 75] },
                    { "recognition": "OCR", "expected": "Attempts:\\s?0\\s?/", "roi": [370, 1135, 300, 45] }
                ]
            }
        ],
        "action": "Click",
        "target": [30, 1185, 90, 70], // back arrow, bottom left
        "post_delay": 1500,
        "timeout": 30000,
        "next": ["DailyDungeon_BackOnList", "DailyDungeon_LeaveResults", "DailyDungeon_UnclaimedPrompt"]
    },
    // The run's grade, the big letter in the banner (S, A, B or C). The
    // "Claim grade" option sets which grades are good enough (GoodGrade) and
    // which aren't (LowGrade); by default every grade is claimed.
    "DailyDungeon_GoodGrade": {
        "recognition": "OCR",
        "expected": "^[SABC]$",
        "roi": [230, 160, 260, 170]
    },
    // Too low: leave without claiming (keeps the attempt); the agent runs again.
    "DailyDungeon_LowGrade": {
        "focus": { "Node.Action.Starting": "Grade below the minimum: leaving without claiming" },
        "recognition": "OCR",
        "expected": "(?!)", // matches nothing
        "roi": [230, 160, 260, 170],
        "next": ["DailyDungeon_Leave"]
    },
    // "Daily Dungeon rewards not claimed. Exit the dungeon?": in Daily mode
    // never exit, go back and claim.
    "DailyDungeon_UnclaimedPrompt": {
        "recognition": "And",
        "all_of": [
            { "recognition": "OCR", "expected": "not\\s?claimed", "roi": [100, 500, 520, 120] },
            { "recognition": "OCR", "expected": "^Cancel$", "roi": [100, 700, 260, 75] }
        ],
        "box_index": 1,
        "action": "Click",
        "post_delay": 1500,
        "next": ["DailyDungeon_Claim", "DailyDungeon_LeaveResults"]
    },
    "DailyDungeon_BackOnList": {
        "focus": { "Node.Action.Starting": "Run complete" },
        "recognition": "And",
        "all_of": ["Screen_DungeonList"]
    },

    // ---------------------------------------------------------------
    // Helpers for the Daily mode agent (agent/daily_dungeon.py).
    // "Daily Reward Attempts: N/2" on the list.
    "DailyDungeon_ListAttempts": {
        "recognition": "OCR",
        "expected": "Attempts:\\s?\\d+\\s?/\\s?\\d+",
        "roi": [230, 30, 260, 45]
    },
    // Dungeon detail: the "+" next to "Daily Reward Attempts: N/2" (or "Out of
    // daily reward attempts." at 0) opens Purchase.
    // Once today's purchases are used up, no popup opens: this node then
    // fails after the timeout and the agent carries on without buying.
    "DailyDungeon_Buy_Open": {
        "recognition": "OCR",
        "expected": "Daily\\s?Reward\\s?Attempts|Out\\s?of\\s?daily\\s?reward",
        "roi": [180, 1005, 360, 55],
        "action": "Click",
        "target": [520, 1008, 55, 50], // the "+" (just right of the text)
        "post_delay": 1500,
        "timeout": 4000,
        "next": ["DailyDungeon_Buy_Limit"]
    },
    // Purchase popup: "Daily Purchase Limit: U/L" (bought today / limit).
    // The "+" after "Daily Reward Attempts: N/M" (yellow-green circle).
    // Not shown once today's attempts are bought and claimed ("Out of daily
    // reward attempts."): nothing left to buy.
    "DailyDungeon_BuyPlus": {
        "recognition": "ColorMatch",
        "method": 4, // RGB
        "roi": [515, 1013, 50, 40],
        "lower": [170, 175, 60],
        "upper": [235, 235, 150],
        "count": 150
    },
    "DailyDungeon_Buy_Limit": {
        "recognition": "OCR",
        "expected": "Purchase\\s?Limit:\\s?\\d+\\s?/\\s?\\d+",
        "roi": [360, 670, 280, 45]
    },
    "DailyDungeon_Buy_Count": { // "Attempt ×N/M": how many will be bought
        "recognition": "OCR",
        "expected": "Attempt\\s?\\S?\\s?\\d+\\s?/\\s?\\d+",
        "roi": [95, 565, 220, 45]
    },
    "DailyDungeon_Buy_More": { // slider "+"
        "action": "Click",
        "target": [575, 620, 45, 45],
        "post_delay": 600
    },
    "DailyDungeon_Buy_Purchase": {
        "recognition": "OCR",
        "expected": "^Purchase$",
        "roi": [370, 715, 245, 60],
        "action": "Click",
        "post_delay": 2000,
        "next": ["DailyDungeon_OnDetail"]
    },
    "DailyDungeon_Buy_Cancel": {
        "recognition": "OCR",
        "expected": "^Cancel$",
        "roi": [105, 715, 245, 60],
        "action": "Click",
        "post_delay": 1500,
        "next": ["DailyDungeon_OnDetail"]
    },
    "DailyDungeon_OnDetail": {
        "recognition": "And",
        "all_of": ["Screen_DungeonDetail"]
    },
    // Dungeon detail: back to the list.
    "DailyDungeon_DetailBack": {
        "recognition": "And",
        "all_of": ["Screen_DungeonDetail"],
        "action": "Click",
        "target": [30, 1185, 90, 70],
        "post_delay": 1500,
        "next": ["DailyDungeon_BackOnList"]
    }
}