{
    // Screen checks, defined once and shared. These nodes only recognise;
    // other nodes use them by name, e.g.
    //   "recognition": "And", "all_of": ["Screen_Home"]
    // (And / Or accept node names). Fix an ROI here and every user gets it.

    // --- Home tab ---
    "Screen_HomeLabel": {
        // "Home" under the house icon in the tab bar
        "recognition": "OCR",
        "roi": [250, 1235, 220, 45],
        "expected": "^Home$"
    },
    "Screen_HomeMenuButton": {
        // cube menu button, right side
        "recognition": "TemplateMatch",
        "roi": [560, 880, 160, 240],
        "template": "Common/menu_button.png"
    },
    "Screen_Home": {
        "recognition": "And",
        "all_of": ["Screen_HomeLabel", "Screen_HomeMenuButton"]
    },
    // House icon in the tab bar of any main tab (Guild, character, ...).
    "Screen_HomeTab": {
        "recognition": "TemplateMatch",
        "roi": [280, 1140, 160, 140],
        "template": "Common/home_tab.png"
    },

    // Any main tab: the bottom tab bar is showing.
    "Screen_TabBar": {
        "recognition": "Or",
        "any_of": ["Screen_Home", "Screen_Journal", "Screen_HomeTab"]
    },

    // Vendor Booth (the cart on Home), any tab.
    "Screen_VendorBooth": {
        "recognition": "OCR",
        "roi": [20, 20, 320, 60],
        "expected": "^Vendor\\s?Booth$"
    },

    // --- Journal tab ---
    "Screen_Journal": {
        "recognition": "OCR",
        "roi": [0, 180, 300, 60],
        "expected": "Free\\s?Attempts"
    },
    "Screen_DungeonList": {
        "recognition": "OCR",
        "roi": [200, 20, 320, 60],
        "expected": "Daily\\s?Reward\\s?Attempts"
    },
    // A dungeon's detail screen (difficulty, Match): the reward attempts line
    // above the Match button.
    "Screen_DungeonDetail": {
        "recognition": "OCR",
        "roi": [180, 1005, 360, 55],
        "expected": "Daily\\s?Reward\\s?Attempts|Out\\s?of\\s?daily\\s?reward"
    },
    // Title of the Crucible pages (Crucible, Rankings and Goals tabs).
    "Screen_CrucibleTitle": {
        "recognition": "OCR",
        "roi": [20, 20, 420, 60],
        "expected": "Crucible\\s?of\\s?Hieromon"
    },
    // Journal > Daily Events: the Crucible of Hieromon tile.
    "Screen_DailyEvents": {
        "recognition": "OCR",
        "roi": [0, 315, 450, 80],
        "expected": "Crucible\\s?of\\s?Hieromon"
    },
    "Screen_CrucibleMenu": {
        // the Crucible tab: title plus the Match button
        "recognition": "And",
        "all_of": ["Screen_CrucibleTitle", "Screen_MatchButton"]
    },
    // --- Competition and Arena (Journal > Competition > Arena) ---
    "Screen_CompetitionPage": {
        "recognition": "OCR",
        "roi": [20, 20, 320, 60],
        "expected": "^Competition$"
    },
    // Title of the Arena pages (OCR may read the "!" badge before it).
    "Screen_ArenaTitle": {
        "recognition": "OCR",
        "roi": [20, 20, 300, 60],
        "expected": "Arena$"
    },
    "Screen_ArenaPage": {
        // the Arena tab: title plus the opponent list
        "recognition": "And",
        "all_of": ["Screen_ArenaTitle", { "recognition": "OCR", "roi": [0, 500, 260, 70], "expected": "^Opponents$" }]
    },

    // --- Material Realms (Journal > Material Realms) ---
    // Title of the list and of each realm's page (OCR may read the "!" badge).
    "Screen_MaterialTitle": {
        "recognition": "OCR",
        "roi": [20, 20, 320, 60],
        "expected": "Material\\s?Realms$"
    },
    "Screen_MaterialList": {
        // the four realms, with Quick Purchase
        "recognition": "And",
        "all_of": [
            "Screen_MaterialTitle",
            { "recognition": "OCR", "roi": [480, 1095, 240, 65], "expected": "^Quick\\s?Purchase$" }
        ]
    },

    // Title of the Split Mirage pages (OCR reads the "!" badge before it).
    "Screen_SplitMirageTitle": {
        "recognition": "OCR",
        "roi": [20, 20, 420, 60],
        "expected": "Split\\s?Mirage$"
    },
    "Screen_SplitMirageMenu": {
        // the Split Mirage tab: title plus the Match button
        "recognition": "And",
        "all_of": ["Screen_SplitMirageTitle", "Screen_MatchButton"]
    },

    // --- Menu and Friends (affection check) ---
    "Screen_MainMenu": {
        // menu opened from Home: "Friends" entry
        "recognition": "OCR",
        "roi": [45, 840, 120, 50],
        "expected": "^Friends$"
    },
    "Screen_FriendsPage": {
        "recognition": "OCR",
        "roi": [20, 100, 260, 50],
        "expected": "^Friends:\\s?\\d+"
    },
    "Screen_AffectionPopup": {
        // "Affection Tokens Earned This Week: N/M"
        "recognition": "OCR",
        "roi": [100, 310, 520, 60],
        "expected": "Earned\\s?This\\s?Week"
    },

    // --- Matchmaking and battles (Daily Dungeon and Crucible) ---
    "Screen_MatchButton": {
        "recognition": "OCR",
        "roi": [370, 1050, 340, 95],
        "expected": "^Match$"
    },
    "Screen_AcceptButton": {
        "recognition": "OCR",
        "roi": [360, 1060, 340, 85],
        "expected": "^Accept$"
    },
    // Big Ready button in battle setup. The ROI keeps out the small "Ready"
    // labels over each player's head.
    "Screen_ReadyButton": {
        "recognition": "OCR",
        "roi": [200, 900, 320, 110],
        "expected": "^Ready$"
    },
    "Screen_Battle": {
        // "Round x/y" at the top
        "recognition": "OCR",
        "roi": [200, 10, 320, 50],
        "expected": "Round\\s?\\d+/\\d+"
    },
    "Screen_DungeonResults": {
        // "Drops" heading
        "recognition": "OCR",
        "roi": [0, 840, 250, 80],
        "expected": "^Drops$"
    },
    // A timed paid offer ("Battle Essence Pack", "Pack disappears in
    // 07:33:59"), opened from the Timed Packs icon. Close with back; never
    // tap the prices.
    "Screen_PackOffer": {
        "recognition": "OCR",
        "roi": [100, 585, 520, 60],
        "expected": "Pack\\s?disappears\\s?in"
    },
    "Screen_TapToContinue": {
        // Crucible and Conquest results
        "recognition": "OCR",
        "roi": [150, 1170, 420, 70],
        "expected": "Tap\\s?to\\s?Continue"
    },
    // Solo battle setup (Conquest). It already shows "Round 0/50" at the
    // top, so check for this before treating a screen as a running battle.
    "Screen_StartBattle": {
        "recognition": "OCR",
        "roi": [220, 915, 280, 80],
        "expected": "^Start\\s?Battle$"
    },

    // --- Guild tab ---
    "Screen_GuildPage": {
        // "Guild" under the selected tab icon
        "recognition": "OCR",
        "roi": [420, 1232, 160, 48],
        "expected": "^Guild$"
    },
    "Screen_GuildEvents": {
        // Gate of Expedition: Guild Clash, Conquest
        "recognition": "OCR",
        "roi": [20, 20, 260, 60],
        "expected": "^Guild\\s?Events$"
    },
    "Screen_ConquestPage": {
        // "Daily Challenge Attempts: N/2"
        "recognition": "OCR",
        "roi": [200, 25, 330, 50],
        "expected": "Daily\\s?Challenge\\s?Attempts"
    },

    // --- Quests (menu > Quest) ---
    "Screen_QuestList": {
        // "Daily Quest" / "Weekly Quest" title
        "recognition": "OCR",
        "roi": [20, 20, 280, 60],
        "expected": "Quest$"
    },

    // --- World map and chat (Grand Mines) ---
    // The world map: Explore / Explore x8 (or x10) buttons, bottom right.
    // Either label: a flashing icon can sit over one of them.
    "Screen_WorldMap": {
        "recognition": "Or",
        "any_of": [
            { "recognition": "OCR", "roi": [480, 1225, 110, 50], "expected": "^Explore$" },
            { "recognition": "OCR", "roi": [580, 1225, 140, 50], "expected": "^Explore\\W?[x×]\\d+$" }
        ]
    },
    // Explore's "Spend Destiny Fruit x1 to explore your destiny at <place>?"
    // (Cancel / OK). Back closes it, spending nothing.
    "Screen_ExploreConfirm": {
        "recognition": "OCR",
        "roi": [100, 470, 520, 45],
        "expected": "^Spend\\s?Destiny\\s?Fruit"
    },
    // Journal > Map Exploration (Resource Hunt, Destiny Exploration).
    "Screen_MapExploration": {
        "recognition": "OCR",
        "roi": [20, 20, 320, 60],
        "expected": "^Map\\s?Exploration$"
    },
    // "Travel to <region> now?" (a chat link) or "Enter <region> to
    // explore?" (Resource Hunt), with Cancel / OK.
    "Screen_TravelPopup": {
        "recognition": "OCR",
        "roi": [100, 540, 520, 90],
        "expected": "^Travel\\s?to.*now\\?$|^Enter.*to\\s?explore\\?$"
    },
    // The full chat (tapping the small chat anywhere but a link opens it).
    "Screen_FullChat": {
        "recognition": "OCR",
        "roi": [85, 1195, 370, 50],
        "expected": "^Enter\\s?your\\s?message$"
    },

    // --- Game start-up ---
    "Screen_Notice": {
        "recognition": "And",
        "all_of": [
            { "recognition": "OCR", "roi": [240, 55, 240, 80], "expected": "^Notice$" },
            { "recognition": "OCR", "roi": [180, 1090, 400, 60], "expected": "show\\s?again" }
        ]
    },
    "Screen_TapToPlay": {
        "recognition": "OCR",
        "roi": [180, 990, 360, 120],
        "expected": "^Tap\\s?to\\s?Play$"
    },
    "Screen_Loading": {
        // "Logging in..." / "Loading patch..." / "Loading..."
        "recognition": "OCR",
        "expected": "^(Logging\\s?in|Loading)"
    }
}
