{
    // Screen checks, defined once and shared. These nodes only recognise;
    // other nodes use them by name, e.g.
    //   "recognition": "And", "all_of": ["Screen_Home"]
    // (And / Or accept node names). Fix an ROI here and every user gets it.

    // --- Home tab ---
    "Screen_HomeLabel": { // "Home" under the house icon in the tab bar
        "recognition": "OCR",
        "expected": "^Home$",
        "roi": [250, 1235, 220, 45]
    },
    "Screen_HomeMenuButton": { // cube menu button, right side
        "recognition": "TemplateMatch",
        "template": "Common/menu_button.png",
        "roi": [560, 880, 160, 240]
    },
    "Screen_Home": {
        "recognition": "And",
        "all_of": ["Screen_HomeLabel", "Screen_HomeMenuButton"]
    },
    // House icon in the tab bar of any main tab (Guild, character, ...).
    "Screen_HomeTab": {
        "recognition": "TemplateMatch",
        "template": "Common/home_tab.png",
        "roi": [280, 1140, 160, 140]
    },

    // Any main tab: the bottom tab bar is showing.
    "Screen_TabBar": {
        "recognition": "Or",
        "any_of": ["Screen_Home", "Screen_Journal", "Screen_HomeTab"]
    },

    // Vendor Booth (the cart on Home), any tab.
    "Screen_VendorBooth": {
        "recognition": "OCR",
        "expected": "^Vendor\\s?Booth$",
        "roi": [20, 20, 320, 60]
    },

    // --- Journal tab ---
    "Screen_Journal": {
        "recognition": "OCR",
        "expected": "Free\\s?Attempts",
        "roi": [0, 180, 300, 60]
    },
    "Screen_DungeonList": {
        "recognition": "OCR",
        "expected": "Daily\\s?Reward\\s?Attempts",
        "roi": [200, 20, 320, 60]
    },
    // A dungeon's detail screen (difficulty, Match): the reward attempts line
    // above the Match button.
    "Screen_DungeonDetail": {
        "recognition": "OCR",
        "expected": "Daily\\s?Reward\\s?Attempts|Out\\s?of\\s?daily\\s?reward",
        "roi": [180, 1005, 360, 55]
    },
    // Title of the Crucible pages (Crucible, Rankings and Goals tabs).
    "Screen_CrucibleTitle": {
        "recognition": "OCR",
        "expected": "Crucible\\s?of\\s?Hieromon",
        "roi": [20, 20, 420, 60]
    },
    // Journal > Daily Events: the Crucible of Hieromon tile.
    "Screen_DailyEvents": {
        "recognition": "OCR",
        "expected": "Crucible\\s?of\\s?Hieromon",
        "roi": [0, 315, 450, 80]
    },
    "Screen_CrucibleMenu": { // the Crucible tab: title plus the Match button
        "recognition": "And",
        "all_of": ["Screen_CrucibleTitle", "Screen_MatchButton"]
    },
    // --- Competition and Arena (Journal > Competition > Arena) ---
    "Screen_CompetitionPage": {
        "recognition": "OCR",
        "expected": "^Competition$",
        "roi": [20, 20, 320, 60]
    },
    // Title of the Arena pages (OCR may read the "!" badge before it).
    "Screen_ArenaTitle": {
        "recognition": "OCR",
        "expected": "Arena$",
        "roi": [20, 20, 300, 60]
    },
    "Screen_ArenaPage": { // the Arena tab: title plus the opponent list
        "recognition": "And",
        "all_of": [
            "Screen_ArenaTitle",
            { "recognition": "OCR", "expected": "^Opponents$", "roi": [0, 500, 260, 70] }
        ]
    },

    // --- Material Realms (Journal > Material Realms) ---
    // Title of the list and of each realm's page (OCR may read the "!" badge).
    "Screen_MaterialTitle": {
        "recognition": "OCR",
        "expected": "Material\\s?Realms$",
        "roi": [20, 20, 320, 60]
    },
    "Screen_MaterialList": { // the four realms, with Quick Purchase
        "recognition": "And",
        "all_of": [
            "Screen_MaterialTitle",
            { "recognition": "OCR", "expected": "^Quick\\s?Purchase$", "roi": [480, 1095, 240, 65] }
        ]
    },

    // Title of the Split Mirage pages (OCR reads the "!" badge before it).
    "Screen_SplitMirageTitle": {
        "recognition": "OCR",
        "expected": "Split\\s?Mirage$",
        "roi": [20, 20, 420, 60]
    },
    "Screen_SplitMirageMenu": { // the Split Mirage tab: title plus the Match button
        "recognition": "And",
        "all_of": ["Screen_SplitMirageTitle", "Screen_MatchButton"]
    },

    // --- Menu and Friends (affection check) ---
    "Screen_MainMenu": { // menu opened from Home: "Friends" entry
        "recognition": "OCR",
        "expected": "^Friends$",
        "roi": [45, 840, 120, 50]
    },
    "Screen_FriendsPage": {
        "recognition": "OCR",
        "expected": "^Friends:\\s?\\d+",
        "roi": [20, 100, 260, 50]
    },
    "Screen_AffectionPopup": { // "Affection Tokens Earned This Week: N/M"
        "recognition": "OCR",
        "expected": "Earned\\s?This\\s?Week",
        "roi": [100, 310, 520, 60]
    },

    // --- Matchmaking and battles (Daily Dungeon and Crucible) ---
    "Screen_MatchButton": {
        "recognition": "OCR",
        "expected": "^Match$",
        "roi": [370, 1050, 340, 95]
    },
    "Screen_AcceptButton": {
        "recognition": "OCR",
        "expected": "^Accept$",
        "roi": [360, 1060, 340, 85]
    },
    // Big Ready button in battle setup. The ROI keeps out the small "Ready"
    // labels over each player's head.
    "Screen_ReadyButton": {
        "recognition": "OCR",
        "expected": "^Ready$",
        "roi": [200, 900, 320, 110]
    },
    "Screen_Battle": { // "Round x/y" at the top
        "recognition": "OCR",
        "expected": "Round\\s?\\d+/\\d+",
        "roi": [200, 10, 320, 50]
    },
    "Screen_DungeonResults": { // "Drops" heading
        "recognition": "OCR",
        "expected": "^Drops$",
        "roi": [0, 840, 250, 80]
    },
    "Screen_TapToContinue": { // Crucible and Conquest results
        "recognition": "OCR",
        "expected": "Tap\\s?to\\s?Continue",
        "roi": [150, 1170, 420, 70]
    },
    // Solo battle setup (Conquest). It already shows "Round 0/50" at the
    // top, so check for this before treating a screen as a running battle.
    "Screen_StartBattle": {
        "recognition": "OCR",
        "expected": "^Start\\s?Battle$",
        "roi": [220, 915, 280, 80]
    },

    // --- Guild tab ---
    "Screen_GuildPage": { // "Guild" under the selected tab icon
        "recognition": "OCR",
        "expected": "^Guild$",
        "roi": [420, 1232, 160, 48]
    },
    "Screen_GuildEvents": { // Gate of Expedition: Guild Clash, Conquest
        "recognition": "OCR",
        "expected": "^Guild\\s?Events$",
        "roi": [20, 20, 260, 60]
    },
    "Screen_ConquestPage": { // "Daily Challenge Attempts: N/2"
        "recognition": "OCR",
        "expected": "Daily\\s?Challenge\\s?Attempts",
        "roi": [200, 25, 330, 50]
    },

    // --- Quests (menu > Quest) ---
    "Screen_QuestList": { // "Daily Quest" / "Weekly Quest" title
        "recognition": "OCR",
        "expected": "Quest$",
        "roi": [20, 20, 280, 60]
    },

    // --- World map and chat (Grand Mines) ---
    // The world map: Explore / Explore x10 buttons, bottom right.
    "Screen_WorldMap": {
        "recognition": "OCR",
        "expected": "^Explore$",
        "roi": [480, 1225, 110, 50]
    },
    // Journal > Map Exploration (Resource Hunt, Destiny Exploration).
    "Screen_MapExploration": {
        "recognition": "OCR",
        "expected": "^Map\\s?Exploration$",
        "roi": [20, 20, 320, 60]
    },
    // "Travel to <region> now?" (a chat link) or "Enter <region> to
    // explore?" (Resource Hunt), with Cancel / OK.
    "Screen_TravelPopup": {
        "recognition": "OCR",
        "expected": "^Travel\\s?to.*now\\?$|^Enter.*to\\s?explore\\?$",
        "roi": [100, 540, 520, 90]
    },
    // The full chat (tapping the small chat anywhere but a link opens it).
    "Screen_FullChat": {
        "recognition": "OCR",
        "expected": "^Enter\\s?your\\s?message$",
        "roi": [85, 1195, 370, 50]
    },

    // --- Game start-up ---
    "Screen_Notice": {
        "recognition": "And",
        "all_of": [
            { "recognition": "OCR", "expected": "^Notice$", "roi": [240, 55, 240, 80] },
            { "recognition": "OCR", "expected": "show\\s?again", "roi": [180, 1090, 400, 60] }
        ]
    },
    "Screen_TapToPlay": {
        "recognition": "OCR",
        "expected": "^Tap\\s?to\\s?Play$",
        "roi": [180, 990, 360, 120]
    },
    "Screen_Loading": { // "Logging in..." / "Loading patch..." / "Loading..."
        "recognition": "OCR",
        "expected": "^(Logging\\s?in|Loading)"
    }
}
