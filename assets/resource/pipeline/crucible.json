{
    // Crucible of Hieromon (Journal > Daily Events). The agent action
    // CrucibleFarm (agent/crucible.py) runs Crucible_Run once, or until
    // today's highest damage reaches the last gift box / last reward on the
    // damage track, then claims.
    // Top-level steps have on_error -> Common_Retry: if anything fails, go
    // Home and start the task over, once.
    "Crucible": {
        "next": ["Crucible_OnMenu", "[JumpBack]Crucible_ToMenu"],
        "on_error": ["Common_Retry"]
    },
    "Crucible_OnMenu": {
        "focus": { "Node.Action.Starting": "On the Crucible menu" },
        "recognition": "And",
        "all_of": ["Screen_CrucibleMenu"],
        "next": ["Crucible_Farm"],
        "on_error": ["Common_Retry"]
    },
    // The mode option sets the param.
    "Crucible_Farm": {
        "action": "Custom",
        "custom_action": "CrucibleFarm",
        "custom_action_param": { "mode": "once" }, // once | marked (gift boxes) | all
        "on_error": ["Common_Retry"]
    },

    // ---------------------------------------------------------------
    // Get to the Crucible menu from any screen: tab bar > Journal > Daily
    // Events > Crucible of Hieromon. Use as "[JumpBack]Crucible_ToMenu".
    "Crucible_ToMenu": {
        "next": [
            "Crucible_ToMenu_Done",
            "Crucible_ToMenu_OtherTab",
            "Crucible_ToMenu_Results",
            "Crucible_ToMenu_DailyEvents",
            "Crucible_ToMenu_Journal",
            "Crucible_ToMenu_TabBar",
            "[JumpBack]Common_ToTabBar"
        ]
    },
    "Crucible_ToMenu_Done": {
        "recognition": "And",
        "all_of": ["Screen_CrucibleMenu"]
    },
    // Rankings or Goals tab (title but no Match button): Crucible tab.
    "Crucible_ToMenu_OtherTab": {
        "recognition": "And",
        "all_of": ["Screen_CrucibleTitle"],
        "action": "Click",
        "target": [160, 1185, 170, 60],
        "post_delay": 1500,
        "next": ["Crucible_ToMenu_Done"]
    },
    // Crucible results (e.g. after a crash relaunch): tap through.
    "Crucible_ToMenu_Results": {
        "recognition": "And",
        "all_of": ["Screen_TapToContinue"],
        "action": "Click",
        "post_delay": 1500,
        "next": ["Crucible_ToMenu_Done", "Crucible_ToMenu_OtherTab", "Crucible_ToMenu_Results"]
    },
    "Crucible_ToMenu_DailyEvents": { // Crucible of Hieromon tile
        "recognition": "And",
        "all_of": ["Screen_DailyEvents"],
        "action": "Click",
        "next": ["Crucible_ToMenu_Done", "Crucible_ToMenu_OtherTab"]
    },
    "Crucible_ToMenu_Journal": { // Daily Events tile
        "recognition": "OCR",
        "expected": "^Daily\\s?Events$",
        "roi": [400, 740, 320, 70],
        "action": "Click",
        "next": ["Crucible_ToMenu_DailyEvents"]
    },
    "Crucible_ToMenu_TabBar": { // Journal tab
        "recognition": "And",
        "all_of": ["Screen_TabBar"],
        "action": "Click",
        "target": [175, 1180, 80, 70],
        "next": ["Crucible_ToMenu_Journal"]
    },

    // ---------------------------------------------------------------
    // One run, from the Crucible menu back to the Crucible menu.
    "Crucible_Run": {
        "next": ["Crucible_InRun", "[JumpBack]Common_Queue"]
    },
    // The fight ("Round x/10"): wait for the results.
    "Crucible_InRun": {
        "recognition": "And",
        "all_of": ["Screen_Battle"],
        "timeout": 300000,
        "next": ["Crucible_Results"]
    },
    // Results: "Battle Ended", Team DMG, "Tap to Continue".
    "Crucible_Results": {
        "focus": { "Node.Action.Starting": "Battle ended" },
        "recognition": "And",
        "all_of": ["Screen_TapToContinue"],
        "pre_delay": 1500, // let the numbers settle
        "timeout": 600000,
        "next": ["Crucible_TeamDmg"]
    },
    // Team DMG (e.g. "5.51B"), shown in the log; then tap to continue.
    "Crucible_TeamDmg": {
        "recognition": "OCR",
        "expected": "^\\d+(\\.\\d+)?[KMB]?$",
        "roi": [45, 728, 280, 50],
        "action": "Click",
        "target": [150, 1170, 420, 70], // Tap to Continue
        "post_delay": 1500,
        "next": ["Crucible_BackOnMenu", "Crucible_TapContinue"]
    },
    // The tap didn't take: tap again.
    "Crucible_TapContinue": {
        "recognition": "And",
        "all_of": ["Screen_TapToContinue"],
        "action": "Click",
        "post_delay": 1500,
        "next": ["Crucible_BackOnMenu", "Crucible_TapContinue"]
    },
    "Crucible_BackOnMenu": {
        "focus": { "Node.Action.Starting": "Back on the Crucible menu" },
        "recognition": "And",
        "all_of": ["Screen_CrucibleTitle"]
    },

    // ---------------------------------------------------------------
    // Damage-track helpers used by the agent.
    "Crucible_HighestToday": { // "Highest DMG Today" value, raw digits
        "recognition": "OCR",
        "expected": "^\\d+$",
        "roi": [150, 815, 420, 55]
    },
    "Crucible_TrackValues": { // reward thresholds under the gifts, e.g. "11.3B"
        "recognition": "OCR",
        "expected": "^\\d+(\\.\\d+)?[KMB]$",
        "roi": [20, 955, 680, 45]
    },
    // Unclaimed gift box icon (blue gift). The agent sets the roi to the spot
    // above each reward label. Claimed rewards show a checkmark instead.
    "Crucible_GiftIcon": {
        "recognition": "TemplateMatch",
        "template": "Crucible/gift.png"
    },
    // Scrolling the track: Common_TrackEnd / Common_TrackStep (common.json).
    // Close whatever claiming opened (rewards popup): back until the menu shows.
    "Crucible_CloseToMenu": {
        "next": ["Crucible_BackOnMenu", "Crucible_CloseToMenu_Back"]
    },
    "Crucible_CloseToMenu_Back": {
        "action": "ClickKey",
        "key": 4,
        "pre_delay": 1000,
        "post_delay": 1500,
        "max_hit": 5,
        "next": ["Crucible_BackOnMenu", "Crucible_CloseToMenu_Back"]
    }
}
