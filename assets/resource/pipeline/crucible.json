{
    // Crucible of Hieromon (Journal > Daily Events). The agent action
    // CrucibleFarm (agent/crucible.py) runs Crucible_Run once, or until
    // today's highest damage reaches the last gift box / last reward on the
    // damage track, then claims.

    // Entry: get to the Crucible menu from any screen.
    // Every top-level step has on_error -> Common_Retry: if anything fails,
    // go Home and start the task over, once.
    "Crucible": {
        "next": [
            "Crucible_OnMenu",
            "Crucible_OnOtherTab",
            "Crucible_OnDailyEvents",
            "Crucible_OnJournal",
            "Crucible_OnHome",
            "[JumpBack]Common_GoHome"
        ],
        "on_error": ["Common_Retry"]
    },
    "Crucible_OnHome": {
        "recognition": "And",
        "all_of": [
            { "recognition": "OCR", "expected": "^Home$", "roi": [250, 1235, 220, 45] },
            { "recognition": "TemplateMatch", "template": "Affection/menu_button.png", "roi": [560, 880, 160, 240] }
        ],
        "action": "Click",
        "target": [175, 1180, 80, 70], // Journal tab
        "next": ["Crucible_OnJournal"],
        "on_error": ["Common_Retry"]
    },
    "Crucible_OnJournal": {
        "recognition": "OCR",
        "expected": "^Daily\\s?Events$",
        "roi": [400, 740, 320, 70],
        "action": "Click",
        "next": ["Crucible_OnDailyEvents"],
        "on_error": ["Common_Retry"]
    },
    "Crucible_OnDailyEvents": {
        "recognition": "OCR",
        "expected": "Crucible\\s?of\\s?Hieromon",
        "roi": [0, 315, 450, 80],
        "action": "Click",
        "next": ["Crucible_OnMenu", "Crucible_OnOtherTab"],
        "on_error": ["Common_Retry"]
    },
    // The Crucible menu: title at the top and the Match button (the title
    // also shows on the Rankings and Goals tabs). The mode option sets the param.
    "Crucible_OnMenu": {
        "focus": { "Node.Action.Starting": "On the Crucible menu" },
        "recognition": "And",
        "all_of": [
            { "recognition": "OCR", "expected": "Crucible\\s?of\\s?Hieromon", "roi": [20, 20, 420, 60] },
            { "recognition": "OCR", "expected": "^Match$", "roi": [370, 1050, 340, 95] }
        ],
        "next": ["Crucible_Farm"],
        "on_error": ["Common_Retry"]
    },
    // Rankings or Goals tab: switch to the Crucible tab (bottom bar).
    "Crucible_OnOtherTab": {
        "recognition": "OCR",
        "expected": "Crucible\\s?of\\s?Hieromon",
        "roi": [20, 20, 420, 60],
        "action": "Click",
        "target": [160, 1185, 170, 60],
        "post_delay": 1500,
        "next": ["Crucible_OnMenu"],
        "on_error": ["Common_Retry"]
    },
    "Crucible_Farm": {
        "action": "Custom",
        "custom_action": "CrucibleFarm",
        "custom_action_param": { "mode": "once" }, // once | all_gifts | all
        "on_error": ["Common_Retry"]
    },


    // ---------------------------------------------------------------
    // One run, from the Crucible menu back to the Crucible menu.
    // Same queue flow as Daily Dungeon: Match, Accept (the game re-queues by
    // itself if someone declines), Match again if we get dropped, Ready.
    "Crucible_Run": {
        "next": ["Crucible_Match"]
    },
    "Crucible_Match": {
        "focus": { "Node.Action.Starting": "Queueing for a match" },
        "recognition": "OCR",
        "expected": "^Match$",
        "roi": [370, 1050, 340, 95],
        "action": "Click",
        "post_delay": 1500,
        "timeout": 600000,
        "next": ["Crucible_Accept", "Crucible_MaybeDropped"]
    },
    "Crucible_Accept": {
        "focus": { "Node.Action.Starting": "Match found: accepting" },
        "recognition": "OCR",
        "expected": "^Accept$",
        "roi": [360, 1060, 340, 85],
        "action": "Click",
        "timeout": 600000,
        "next": ["Crucible_Ready", "Crucible_InRun", "Crucible_Accept", "Crucible_MaybeDropped"]
    },
    // Match showing again: dropped from the queue, or just the brief flash
    // while the battle loads. Wait, then look again before pressing Match.
    "Crucible_MaybeDropped": {
        "focus": { "Node.Action.Starting": "Back on Match: waiting, then re-queueing if dropped" },
        "recognition": "OCR",
        "expected": "^Match$",
        "roi": [370, 1050, 340, 95],
        "post_delay": 10000,
        "timeout": 600000,
        "next": ["Crucible_Ready", "Crucible_InRun", "Crucible_Accept", "Crucible_Match"]
    },
    "Crucible_Ready": {
        "focus": { "Node.Action.Starting": "Ready" },
        "recognition": "OCR",
        "expected": "^Ready$",
        "roi": [200, 900, 320, 110],
        "action": "Click",
        "timeout": 90000,
        "next": ["Crucible_InRun"]
    },
    // The fight: "Round x/10" at the top. Wait for the results.
    "Crucible_InRun": {
        "focus": { "Node.Action.Starting": "Battle in progress" },
        "recognition": "OCR",
        "expected": "Round\\s?\\d+/\\d+",
        "roi": [200, 10, 320, 50],
        "timeout": 300000,
        "next": ["Crucible_Results"]
    },
    // Results: "Battle Ended", Team DMG, "Tap to Continue".
    "Crucible_Results": {
        "focus": { "Node.Action.Starting": "Battle ended" },
        "recognition": "OCR",
        "expected": "Tap\\s?to\\s?Continue",
        "roi": [150, 1170, 420, 70],
        "pre_delay": 1500, // let the numbers settle
        "timeout": 600000,
        "next": ["Crucible_TeamDmg"]
    },
    // Team DMG (e.g. "5.51B"). The agent reads this node's text.
    "Crucible_TeamDmg": {
        "recognition": "OCR",
        "expected": "^\\d+(\\.\\d+)?[KMB]?$",
        "roi": [45, 728, 280, 50],
        "action": "Click",
        "target": [150, 1170, 420, 70], // Tap to Continue
        "post_delay": 1500,
        "next": ["Crucible_BackOnMenu", "Crucible_TapContinue"]
    },
    // The tap didn't take: tap again.
    "Crucible_TapContinue": {
        "recognition": "OCR",
        "expected": "Tap\\s?to\\s?Continue",
        "roi": [150, 1170, 420, 70],
        "action": "Click",
        "post_delay": 1500,
        "next": ["Crucible_BackOnMenu", "Crucible_TapContinue"]
    },
    "Crucible_BackOnMenu": {
        "focus": { "Node.Action.Starting": "Back on the Crucible menu" },
        "recognition": "OCR",
        "expected": "Crucible\\s?of\\s?Hieromon",
        "roi": [20, 20, 420, 60]
    },

    // ---------------------------------------------------------------
    // Damage-track helpers used by the agent.
    "Crucible_HighestToday": { // "Highest DMG Today" value, raw digits
        "recognition": "OCR",
        "expected": "^\\d+$",
        "roi": [150, 815, 420, 55]
    },
    "Crucible_TrackValues": { // reward thresholds under the gifts, e.g. "11.3B"
        "recognition": "OCR",
        "expected": "^\\d+(\\.\\d+)?[KMB]$",
        "roi": [20, 955, 680, 45]
    },
    // Unclaimed gift box icon (blue gift). The agent sets the roi to the spot
    // above each reward label. Claimed rewards show a checkmark instead.
    "Crucible_GiftIcon": {
        "recognition": "TemplateMatch",
        "template": "Crucible/gift.png"
    },
    "Crucible_TrackRight": {
        "action": "Swipe",
        "begin": [620, 920, 10, 10],
        "end": [80, 920, 10, 10],
        "duration": 600,
        "post_delay": 1500
    },
    // Half a screen back towards the start, for scanning from the right end.
    "Crucible_TrackStep": {
        "action": "Swipe",
        "begin": [220, 920, 10, 10],
        "end": [500, 920, 10, 10],
        "duration": 800,
        "post_delay": 1200
    },
    "Crucible_TrackLeft": {
        "action": "Swipe",
        "begin": [80, 920, 10, 10],
        "end": [620, 920, 10, 10],
        "duration": 600,
        "post_delay": 1500
    },
    // Close whatever claiming opened (rewards popup): back until the menu shows.
    "Crucible_CloseToMenu": {
        "next": ["Crucible_BackOnMenu", "Crucible_CloseToMenu_Back"]
    },
    "Crucible_CloseToMenu_Back": {
        "action": "ClickKey",
        "key": 4,
        "pre_delay": 1000,
        "post_delay": 1500,
        "max_hit": 5,
        "next": ["Crucible_BackOnMenu", "Crucible_CloseToMenu_Back"]
    }
}
