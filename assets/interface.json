{
    // Defines what the GUI (MFAAvalonia) shows: tasks, options, controller, agent.
    // Docs: https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    "interface_version": 2,
    "name": "MaaSxS",
    "description": "Sword x Staff automation, built on MaaFramework. The emulator must run at 720x1280.",
    "license": "MIT",
    "welcome": "Set your emulator to 720x1280 (portrait) before starting.",
    // Project URL and version enable the GUI's update check.
    "github": "https://github.com/stevenoctopus/MaaSxS",
    "version": "0.1.0",
    "controller": [
        {
            "name": "Android",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "Global",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "DailyDungeon",
            "label": "Daily Dungeon",
            "entry": "DailyDungeon",
            "option": [
                "Mode",
                "Dungeon",
                "Difficulty"
            ]
        },
        {
            "name": "Crucible",
            "label": "Crucible of Hieromon",
            "entry": "Crucible",
            "option": [
                "CrucibleMode"
            ]
        },
        {
            "name": "SplitMirage",
            "label": "Split Mirage",
            "entry": "SplitMirage",
            "option": [
                "SplitMirageMode"
            ]
        },
        {
            "name": "Conquest",
            "label": "Conquest",
            "entry": "Conquest",
            "option": [
                "ConquestRuns"
            ]
        },
        {
            "name": "Arena",
            "label": "Arena",
            "entry": "Arena",
            "option": [
                "ArenaTickets"
            ]
        },
        {
            "name": "MaterialRealms",
            "label": "Material Realms",
            "entry": "MaterialRealms",
            "option": [
                "MaterialBuy",
                "MaterialUse"
            ]
        },
        {
            "name": "VendorBooth",
            "label": "Vendor Booth",
            "entry": "VendorBooth",
            "option": [
                "VendorRefreshes",
                "VendorDiscount",
                "VendorStellatie",
                "VendorDestinyFruit",
                "VendorWornKnuckles",
                "VendorSandShovel",
                "VendorRefinedOre",
                "VendorAuroralBadge",
                "VendorMandrake",
                "VendorQuestScroll"
            ]
        },
        {
            // Last, so it claims what the other tasks completed.
            "name": "DailyQuests",
            "label": "Claim daily quests",
            "entry": "DailyQuests"
        }
    ],
    "option": {
        // Shown under Daily Dungeon's Daily mode. Spends Dawnium (100 for the
        // first attempt); never more than the game's daily purchase limit.
        "DungeonBuy": {
            "type": "select",
            "label": "Buy extra attempts",
            "default_case": "2",
            "cases": [
                {
                    "name": "0",
                    "description": "Don't buy any.",
                    "pipeline_override": {
                        "DailyDungeon_DailyFarm": {
                            "custom_action_param": {
                                "buy": 0
                            }
                        }
                    }
                },
                {
                    "name": "1",
                    "description": "Have 1 extra reward attempt bought today, with Dawnium (attempts already bought today count).",
                    "pipeline_override": {
                        "DailyDungeon_DailyFarm": {
                            "custom_action_param": {
                                "buy": 1
                            }
                        }
                    }
                },
                {
                    "name": "2",
                    "description": "Have 2 extra reward attempts bought today, with Dawnium (the daily limit; attempts already bought today count).",
                    "pipeline_override": {
                        "DailyDungeon_DailyFarm": {
                            "custom_action_param": {
                                "buy": 2
                            }
                        }
                    }
                }
            ]
        },
        // Shown under Daily Dungeon's Daily mode. A run below the grade
        // leaves without claiming (the reward attempt is kept) and runs again.
        "DungeonGrade": {
            "type": "select",
            "label": "Claim grade",
            "default_case": "S",
            "cases": [
                {
                    "name": "S",
                    "description": "Only claim S runs.",
                    "pipeline_override": {
                        "DailyDungeon_GoodGrade": { "expected": "^S$" },
                        "DailyDungeon_LowGrade": { "expected": "^[ABC]$" }
                    }
                },
                {
                    "name": "A or higher",
                    "description": "Claim S and A runs.",
                    "pipeline_override": {
                        "DailyDungeon_GoodGrade": { "expected": "^[SA]$" },
                        "DailyDungeon_LowGrade": { "expected": "^[BC]$" }
                    }
                },
                {
                    "name": "B or higher",
                    "description": "Claim S, A and B runs.",
                    "pipeline_override": {
                        "DailyDungeon_GoodGrade": { "expected": "^[SAB]$" },
                        "DailyDungeon_LowGrade": { "expected": "^C$" }
                    }
                },
                {
                    "name": "Any",
                    "description": "Claim every run."
                }
            ]
        },
        // Both inputs in one option: two options overriding Arena_Farm's
        // custom_action_param would replace each other's param.
        "ArenaTickets": {
            "type": "input",
            "label": "Tickets",
            "inputs": [
                {
                    "name": "buy",
                    "label": "Tickets to buy",
                    "description": "Tickets to buy per day, bought first, with Dawnium (the price rises per ticket). Tickets already bought today count, so running twice won't buy twice. Never past the game's daily limit of 8.",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^[0-8]$",
                    "pattern_msg": "Enter 0 to 8"
                },
                {
                    "name": "tickets",
                    "label": "Tickets to use",
                    "description": "One challenge per ticket, against the rightmost opponent. Never more than the tickets you have.",
                    "default": "2",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "pattern_msg": "Enter a whole number, e.g. 2"
                }
            ],
            "pipeline_override": {
                "Arena_Farm": {
                    "custom_action_param": {
                        "buy": "{buy}",
                        "tickets": "{tickets}"
                    }
                }
            }
        },
        // Material Realms: buying and using are separate nodes, so each option
        // overrides its own node's param.
        "MaterialBuy": {
            "type": "input",
            "label": "Sets to buy",
            "description": "Sets of 5 tools per realm to buy per day, with Dawnium, before using (bought on each realm's page). Sets already bought today count, so running twice won't buy twice. Never past the game's daily limit of 20 per realm.",
            "inputs": [
                { "name": "ironvein", "label": "Ironvein Pit (hammers)", "default": "0", "pipeline_type": "int", "verify": "^([0-9]|1[0-9]|20)$", "pattern_msg": "Enter 0 to 20" },
                { "name": "gilded", "label": "Gilded Depths (pickaxes)", "default": "0", "pipeline_type": "int", "verify": "^([0-9]|1[0-9]|20)$", "pattern_msg": "Enter 0 to 20" },
                { "name": "dread", "label": "Dread Hollow (gloves)", "default": "0", "pipeline_type": "int", "verify": "^([0-9]|1[0-9]|20)$", "pattern_msg": "Enter 0 to 20" },
                { "name": "dustfall", "label": "Dustfall Dune (shovels)", "default": "0", "pipeline_type": "int", "verify": "^([0-9]|1[0-9]|20)$", "pattern_msg": "Enter 0 to 20" }
            ],
            "pipeline_override": {
                "MaterialRealms_Buy": {
                    "custom_action_param": { "ironvein": "{ironvein}", "gilded": "{gilded}", "dread": "{dread}", "dustfall": "{dustfall}" }
                }
            }
        },
        "MaterialUse": {
            "type": "input",
            "label": "Tools to use",
            "description": "Per realm: a number, or ALL. ALL turns on Quick Mine / Quick Conquer and uses every tool; a number turns it off and uses exactly that many.",
            "inputs": [
                { "name": "ironvein", "label": "Ironvein Pit", "default": "ALL", "pipeline_type": "string", "verify": "^(ALL|All|all|\\d+)$", "pattern_msg": "Enter a number or ALL" },
                { "name": "gilded", "label": "Gilded Depths", "default": "ALL", "pipeline_type": "string", "verify": "^(ALL|All|all|\\d+)$", "pattern_msg": "Enter a number or ALL" },
                { "name": "dread", "label": "Dread Hollow", "default": "ALL", "pipeline_type": "string", "verify": "^(ALL|All|all|\\d+)$", "pattern_msg": "Enter a number or ALL" },
                { "name": "dustfall", "label": "Dustfall Dune", "default": "ALL", "pipeline_type": "string", "verify": "^(ALL|All|all|\\d+)$", "pattern_msg": "Enter a number or ALL" }
            ],
            "pipeline_override": {
                "MaterialRealms_Use": {
                    "custom_action_param": { "ironvein": "{ironvein}", "gilded": "{gilded}", "dread": "{dread}", "dustfall": "{dustfall}" }
                }
            }
        },
        // Vendor Booth: each option overrides its own node's param.
        "VendorRefreshes": {
            "type": "input",
            "label": "General: refreshes",
            "inputs": [
                {
                    "name": "refreshes",
                    "label": "General: refreshes",
                    "description": "Refreshes to use per day (gold). The current items are always bought from first, then each refresh's. Refreshes already used today count, so running twice won't refresh twice. 0 to 10 (the game's daily limit).",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^([0-9]|10)$",
                    "pattern_msg": "Enter 0 to 10"
                }
            ],
            "pipeline_override": {
                "VendorBooth_Refreshes": { "custom_action_param": { "refreshes": "{refreshes}" } }
            }
        },
        "VendorDiscount": {
            "type": "select",
            "label": "General: buy items",
            "default_case": "Always",
            "cases": [
                { "name": "Always", "description": "Buy all 9 items (gold)." },
                { "name": "10% off or more", "pipeline_override": { "VendorBooth_General": { "custom_action_param": { "discount": 10 } } } },
                { "name": "20% off or more", "pipeline_override": { "VendorBooth_General": { "custom_action_param": { "discount": 20 } } } },
                { "name": "30% off or more", "pipeline_override": { "VendorBooth_General": { "custom_action_param": { "discount": 30 } } } },
                { "name": "40% off or more", "pipeline_override": { "VendorBooth_General": { "custom_action_param": { "discount": 40 } } } },
                { "name": "50% off or more", "pipeline_override": { "VendorBooth_General": { "custom_action_param": { "discount": 50 } } } },
                { "name": "60% off or more", "pipeline_override": { "VendorBooth_General": { "custom_action_param": { "discount": 60 } } } }
            ]
        },
        // Vault items (Dawnium). The Free reward is always claimed.
        "VendorStellatie": {
            "type": "select", "label": "Vault: Stellatie", "default_case": "Skip",
            "cases": [{ "name": "Skip" }, { "name": "Buy", "pipeline_override": { "VendorBooth_Vault_Stellatie": { "custom_action_param": { "buy": 1 } } } }]
        },
        "VendorDestinyFruit": {
            "type": "select", "label": "Vault: Destiny Fruit", "default_case": "Skip",
            "cases": [{ "name": "Skip" }, { "name": "Buy", "description": "Both (limit 2).", "pipeline_override": { "VendorBooth_Vault_DestinyFruit": { "custom_action_param": { "buy": 1 } } } }]
        },
        "VendorWornKnuckles": {
            "type": "select", "label": "Vault: Worn Knuckles", "default_case": "Skip",
            "cases": [{ "name": "Skip" }, { "name": "Buy", "pipeline_override": { "VendorBooth_Vault_WornKnuckles": { "custom_action_param": { "buy": 1 } } } }]
        },
        "VendorSandShovel": {
            "type": "select", "label": "Vault: Sand Shovel", "default_case": "Skip",
            "cases": [{ "name": "Skip" }, { "name": "Buy", "pipeline_override": { "VendorBooth_Vault_SandShovel": { "custom_action_param": { "buy": 1 } } } }]
        },
        "VendorRefinedOre": {
            "type": "select", "label": "Vault: Refined Ore", "default_case": "Skip",
            "cases": [{ "name": "Skip" }, { "name": "Buy", "pipeline_override": { "VendorBooth_Vault_RefinedOre": { "custom_action_param": { "buy": 1 } } } }]
        },
        "VendorAuroralBadge": {
            "type": "select", "label": "Vault: Epic Auroral Badge", "default_case": "Skip",
            "cases": [{ "name": "Skip" }, { "name": "Buy", "pipeline_override": { "VendorBooth_Vault_AuroralBadge": { "custom_action_param": { "buy": 1 } } } }]
        },
        "VendorMandrake": {
            "type": "select", "label": "Vault: Mandrake", "default_case": "Skip",
            "cases": [{ "name": "Skip" }, { "name": "Buy", "pipeline_override": { "VendorBooth_Vault_Mandrake": { "custom_action_param": { "buy": 1 } } } }]
        },
        "VendorQuestScroll": {
            "type": "select", "label": "Vault: Quest Scroll", "default_case": "Skip",
            "cases": [{ "name": "Skip" }, { "name": "Buy", "pipeline_override": { "VendorBooth_Vault_QuestScroll": { "custom_action_param": { "buy": 1 } } } }]
        },
        "ConquestRuns": {
            "type": "select",
            "label": "Runs",
            "default_case": "Once",
            "cases": [
                {
                    "name": "Once",
                    "description": "One run (enough for the daily quest)."
                },
                {
                    "name": "Twice",
                    "description": "Two runs, or as many attempts as are left today.",
                    "pipeline_override": {
                        "Conquest_Farm": {
                            "custom_action_param": {
                                "runs": 2
                            }
                        }
                    }
                }
            ]
        },
        "CrucibleMode": {
            "type": "select",
            "label": "Mode",
            "default_case": "Once",
            "cases": [
                {
                    "name": "Once",
                    "description": "Play one run, then claim (daily)."
                },
                {
                    "name": "All gifts",
                    "description": "Read today's damage track, then run until today's highest damage reaches the last gift box, then claim.",
                    "pipeline_override": {
                        "Crucible_Farm": {
                            "custom_action_param": {
                                "mode": "marked"
                            }
                        }
                    }
                },
                {
                    "name": "All rewards",
                    "description": "Read today's damage track, then run until today's highest damage reaches the last reward, then claim.",
                    "pipeline_override": {
                        "Crucible_Farm": {
                            "custom_action_param": {
                                "mode": "all"
                            }
                        }
                    }
                }
            ]
        },
        "SplitMirageMode": {
            "type": "select",
            "label": "Mode",
            "default_case": "Once",
            "cases": [
                {
                    "name": "Once",
                    "description": "Play one run, then claim (daily)."
                },
                {
                    "name": "All gems",
                    "description": "Read today's reward track, then run until today's best wave reaches the last gem, then claim.",
                    "pipeline_override": {
                        "SplitMirage_Farm": {
                            "custom_action_param": {
                                "mode": "marked"
                            }
                        }
                    }
                },
                {
                    "name": "All rewards",
                    "description": "Read today's reward track, then run until today's best wave reaches the last reward, then claim.",
                    "pipeline_override": {
                        "SplitMirage_Farm": {
                            "custom_action_param": {
                                "mode": "all"
                            }
                        }
                    }
                }
            ]
        },
        "Mode": {
            "type": "select",
            "label": "Mode",
            "default_case": "Daily",
            "cases": [
                {
                    "name": "Affection",
                    "description": "Check this week's affection, run the dungeons needed to reach the weekly cap (+7 per run), then check again and repeat until capped. Never claims dungeon rewards, so reward attempts are kept.",
                    "pipeline_override": {
                        // Skip the walk to the list: the affection check
                        // starts from any screen and ends on the list.
                        "DailyDungeon": {
                            "next": [
                                "DailyDungeon_AffectionFarm"
                            ]
                        }
                    }
                },
                {
                    "name": "Daily",
                    "description": "Buy extra reward attempts (optional), then run and claim rewards until no reward attempts are left.",
                    "option": [
                        "DungeonBuy",
                        "DungeonGrade"
                    ]
                }
            ]
        },
        "Dungeon": {
            "type": "select",
            "label": "Dungeon",
            "default_case": "Riftwatch Fortress",
            "cases": [
                {
                    "name": "Riftwatch Fortress",
                    "pipeline_override": {
                        "DailyDungeon_SelectCard": {
                            "expected": "Riftwatch\\s?Fortress"
                        }
                    }
                },
                {
                    "name": "Court of Purification",
                    "pipeline_override": {
                        "DailyDungeon_SelectCard": {
                            "expected": "Court\\s?of\\s?Purification"
                        }
                    }
                }
            ]
        },
        "Difficulty": {
            "type": "select",
            "label": "Difficulty",
            "default_case": "Purgatory",
            "cases": [
                {
                    "name": "Normal",
                    "pipeline_override": {
                        "DailyDungeon_SelectDifficulty": {
                            "expected": "^Normal$"
                        },
                        "DailyDungeon_DifficultySelected": {
                            "expected": "Normal$"
                        }
                    }
                },
                {
                    "name": "Hard",
                    "pipeline_override": {
                        "DailyDungeon_SelectDifficulty": {
                            "expected": "^Hard$"
                        },
                        "DailyDungeon_DifficultySelected": {
                            "expected": "Hard$"
                        }
                    }
                },
                {
                    "name": "Nightmare",
                    "pipeline_override": {
                        "DailyDungeon_SelectDifficulty": {
                            "expected": "^Nightmare$"
                        },
                        "DailyDungeon_DifficultySelected": {
                            "expected": "Nightmare$"
                        }
                    }
                },
                {
                    "name": "Purgatory",
                    "pipeline_override": {
                        "DailyDungeon_SelectDifficulty": {
                            "expected": "^Purgatory$"
                        },
                        "DailyDungeon_DifficultySelected": {
                            "expected": "Purgatory$"
                        }
                    }
                }
            ]
        }
    }
}
