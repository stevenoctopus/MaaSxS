{
    // Defines what the GUI (MFAAvalonia) shows: tasks, options, controller, agent.
    // Docs: https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    "interface_version": 2,
    "name": "MaaSxS",
    "description": "Sword x Staff automation, built on MaaFramework. The emulator must run at 720x1280.",
    "license": "MIT",
    "welcome": "Set your emulator to 720x1280 (portrait) before starting.",
    // Project URL and version enable the GUI's update check.
    "github": "https://github.com/stevenoctopus/MaaSxS",
    "version": "0.1.0",
    "controller": [
        {
            "name": "Android",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "Global",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "DailyDungeon",
            "label": "Daily Dungeon",
            "entry": "DailyDungeon",
            "option": [
                "Mode",
                "Dungeon",
                "Difficulty"
            ]
        },
        {
            "name": "Crucible",
            "label": "Crucible of Hieromon",
            "entry": "Crucible",
            "option": [
                "CrucibleMode"
            ]
        },
        {
            "name": "Conquest",
            "label": "Conquest",
            "entry": "Conquest",
            "option": [
                "ConquestRuns"
            ]
        },
        {
            // Last, so it claims what the other tasks completed.
            "name": "DailyQuests",
            "label": "Claim daily quests",
            "entry": "DailyQuests"
        }
    ],
    "option": {
        "ConquestRuns": {
            "type": "select",
            "label": "Runs",
            "default_case": "Once",
            "cases": [
                {
                    "name": "Once",
                    "description": "One run (enough for the daily quest)."
                },
                {
                    "name": "Twice",
                    "description": "Two runs, or as many attempts as are left today.",
                    "pipeline_override": {
                        "Conquest_Farm": {
                            "custom_action_param": {
                                "runs": 2
                            }
                        }
                    }
                }
            ]
        },
        "CrucibleMode": {
            "type": "select",
            "label": "Mode",
            "default_case": "Once",
            "cases": [
                {
                    "name": "Once",
                    "description": "Play one run, then claim (daily)."
                },
                {
                    "name": "All gifts",
                    "description": "Read today's damage track, then run until today's highest damage reaches the last gift box, then claim.",
                    "pipeline_override": {
                        "Crucible_Farm": {
                            "custom_action_param": {
                                "mode": "all_gifts"
                            }
                        }
                    }
                },
                {
                    "name": "All rewards",
                    "description": "Read today's damage track, then run until today's highest damage reaches the last reward, then claim.",
                    "pipeline_override": {
                        "Crucible_Farm": {
                            "custom_action_param": {
                                "mode": "all"
                            }
                        }
                    }
                }
            ]
        },
        "Mode": {
            "type": "select",
            "label": "Mode",
            "default_case": "Single run",
            "cases": [
                {
                    "name": "Single run",
                    "description": "Play one run, then stop."
                },
                {
                    "name": "Affection",
                    "description": "Check this week's affection, run the dungeons needed to reach the weekly cap (+7 per run), then check again and repeat until capped.",
                    "pipeline_override": {
                        // Skip the walk to the list: the affection check
                        // starts from any screen and ends on the list.
                        "DailyDungeon": {
                            "next": [
                                "DailyDungeon_AffectionFarm"
                            ]
                        }
                    }
                }
            ]
        },
        "Dungeon": {
            "type": "select",
            "label": "Dungeon",
            "default_case": "Riftwatch Fortress",
            "cases": [
                {
                    "name": "Riftwatch Fortress",
                    "pipeline_override": {
                        "DailyDungeon_SelectCard": {
                            "expected": "Riftwatch\\s?Fortress"
                        }
                    }
                },
                {
                    "name": "Court of Purification",
                    "pipeline_override": {
                        "DailyDungeon_SelectCard": {
                            "expected": "Court\\s?of\\s?Purification"
                        }
                    }
                }
            ]
        },
        "Difficulty": {
            "type": "select",
            "label": "Difficulty",
            "default_case": "Hard",
            "cases": [
                {
                    "name": "Normal",
                    "pipeline_override": {
                        "DailyDungeon_SelectDifficulty": {
                            "expected": "^Normal$"
                        },
                        "DailyDungeon_DifficultySelected": {
                            "expected": "Normal$"
                        }
                    }
                },
                {
                    "name": "Hard",
                    "pipeline_override": {
                        "DailyDungeon_SelectDifficulty": {
                            "expected": "^Hard$"
                        },
                        "DailyDungeon_DifficultySelected": {
                            "expected": "Hard$"
                        }
                    }
                },
                {
                    "name": "Nightmare",
                    "pipeline_override": {
                        "DailyDungeon_SelectDifficulty": {
                            "expected": "^Nightmare$"
                        },
                        "DailyDungeon_DifficultySelected": {
                            "expected": "Nightmare$"
                        }
                    }
                },
                {
                    "name": "Purgatory",
                    "pipeline_override": {
                        "DailyDungeon_SelectDifficulty": {
                            "expected": "^Purgatory$"
                        },
                        "DailyDungeon_DifficultySelected": {
                            "expected": "Purgatory$"
                        }
                    }
                }
            ]
        }
    }
}
